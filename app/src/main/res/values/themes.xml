    <!-- Shared component styling. Palettes below only change colors. -->
    <!-- Fixed themes use a fixed light/dark base, so changing theme never
         changes the app night mode (which would recreate the screen twice). -->
    <style name="Base.Theme.DashDeck" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:enforceNavigationBarContrast">false</item>
        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.DashDeck.Small</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.DashDeck.Medium</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.DashDeck.Medium</item>
        <item name="shapeAppearanceCornerExtraSmall">@style/ShapeAppearance.DashDeck.Small</item>
        <item name="shapeAppearanceCornerSmall">@style/ShapeAppearance.DashDeck.Small</item>
        <item name="shapeAppearanceCornerMedium">@style/ShapeAppearance.DashDeck.Medium</item>
        <item name="shapeAppearanceCornerLarge">@style/ShapeAppearance.DashDeck.Medium</item>
        <item name="shapeAppearanceCornerExtraLarge">@style/ShapeAppearance.DashDeck.Medium</item>
        <item name="materialButtonStyle">@style/Widget.DashDeck.Button</item>
        <item name="materialButtonOutlinedStyle">@style/Widget.DashDeck.Button.Outlined</item>
        <item name="materialButtonTonalStyle">@style/Widget.DashDeck.Button.Tonal</item>
        <item name="borderlessButtonStyle">@style/Widget.DashDeck.Button.Text</item>
        <item name="materialIconButtonStyle">@style/Widget.DashDeck.IconButton</item>
        <item name="materialCardViewStyle">@style/Widget.DashDeck.Card</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.DashDeck.Dialog</item>
        <item name="bottomSheetDialogTheme">@style/ThemeOverlay.DashDeck.BottomSheetDialog</item>
        <item name="materialSwitchStyle">@style/Widget.Material3.CompoundButton.MaterialSwitch</item>
        <item name="textInputStyle">@style/Widget.DashDeck.TextInput</item>
    </style>

