<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Shapes: one squared-off radius family, no pills. -->
    <style name="ShapeAppearance.DashDeck.Small" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">6dp</item>
    </style>

    <style name="ShapeAppearance.DashDeck.Medium" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">8dp</item>
    </style>

    <style name="ShapeAppearance.DashDeck.Sheet" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">12dp</item>
        <item name="cornerSizeTopRight">12dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    <!-- Buttons -->
    <style name="Widget.DashDeck.Button" parent="Widget.Material3.Button">
        <item name="shapeAppearance">@style/ShapeAppearance.DashDeck.Medium</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textAppearance">@style/TextAppearance.DashDeck.Button</item>
        <item name="elevation">0dp</item>
    </style>

    <style name="Widget.DashDeck.Button.Tonal" parent="Widget.Material3.Button.TonalButton">
        <item name="shapeAppearance">@style/ShapeAppearance.DashDeck.Medium</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textAppearance">@style/TextAppearance.DashDeck.Button</item>
        <item name="backgroundTint">?attr/colorSurfaceContainerHigh</item>
        <item name="android:textColor">@color/on_surface_stateful</item>
        <item name="iconTint">@color/on_surface_stateful</item>
    </style>

    <style name="Widget.DashDeck.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="shapeAppearance">@style/ShapeAppearance.DashDeck.Medium</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textAppearance">@style/TextAppearance.DashDeck.Button</item>
        <item name="strokeColor">?attr/colorOutline</item>
        <item name="android:textColor">@color/on_surface_stateful</item>
        <item name="iconTint">@color/on_surface_stateful</item>
    </style>

    <style name="Widget.DashDeck.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="shapeAppearance">@style/ShapeAppearance.DashDeck.Medium</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textAppearance">@style/TextAppearance.DashDeck.Button</item>
    </style>

    <style name="Widget.DashDeck.IconButton" parent="Widget.Material3.Button.IconButton">
        <item name="shapeAppearance">@style/ShapeAppearance.DashDeck.Medium</item>
        <item name="iconTint">@color/on_surface_variant_stateful</item>
        <item name="iconSize">22dp</item>
        <item name="android:minWidth">48dp</item>
        <item name="android:minHeight">48dp</item>
    </style>

    <!-- A square tile: icon over a short label. Used for menu actions. -->
    <style name="Widget.DashDeck.ActionTile" parent="Widget.DashDeck.Button.Tonal">
        <item name="iconGravity">top</item>
        <item name="iconSize">22dp</item>
        <item name="iconPadding">6dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">10dp</item>
        <item name="android:minHeight">72dp</item>
        <item name="android:textAppearance">@style/TextAppearance.DashDeck.Label</item>
        <item name="backgroundTint">?attr/colorSurfaceContainer</item>
        <item name="android:textColor">@color/on_surface_stateful</item>
        <item name="iconTint">@color/on_surface_stateful</item>
    </style>

    <!-- Cards: flat surface, hairline outline. -->
    <style name="Widget.DashDeck.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="shapeAppearance">@style/ShapeAppearance.DashDeck.Medium</item>
        <item name="cardBackgroundColor">?attr/colorSurfaceContainerLow</item>
        <item name="strokeColor">?attr/colorOutlineVariant</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardElevation">0dp</item>
    </style>

    <style name="Widget.DashDeck.TextInput" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="shapeAppearance">@style/ShapeAppearance.DashDeck.Medium</item>
        <item name="boxStrokeColor">?attr/colorPrimary</item>
    </style>

    <!-- Dialogs and sheets -->
    <style name="ThemeOverlay.DashDeck.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.DashDeck.Medium</item>
        <item name="colorSurfaceContainerHigh">?attr/colorSurfaceContainer</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.DashDeck.Button.Text</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.DashDeck.Button.Text</item>
        <item name="buttonBarNeutralButtonStyle">@style/Widget.DashDeck.Button.Text</item>
    </style>

    <style name="ThemeOverlay.DashDeck.BottomSheetDialog" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Widget.DashDeck.BottomSheet</item>
    </style>

    <style name="Widget.DashDeck.BottomSheet" parent="Widget.Material3.BottomSheet">
        <item name="shapeAppearance">@style/ShapeAppearance.DashDeck.Sheet</item>
        <item name="backgroundTint">?attr/colorSurfaceContainer</item>
    </style>

    <!-- Type -->
    <style name="TextAppearance.DashDeck.Button" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.DashDeck.Label" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="TextAppearance.DashDeck.Overline" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <style name="TextAppearance.DashDeck.Title" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <style name="TextAppearance.DashDeck.Headline" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>
</resources>
